# Copy to .env (or export these as real environment variables) before
# running the API. The backend connects DIRECTLY to your existing Signet
# MySQL database — no separate/new database is created.

APP_NAME=Signetint.net
APP_URL=http://127.0.0.1:8080
APP_ENV=local
PORT=8080

# Point these at your EXISTING crypto-app database (same values as that
# app's .env DB_* keys).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=signet_last
DB_USERNAME=root
DB_PASSWORD=

# Used to sign the session JWT stored in the httpOnly signet_session cookie.
# Set this to a long random value in production.
SESSION_SECRET=change-me-to-a-long-random-value
SESSION_LIFETIME=120

# Outbound mail (registration/password-reset notifications). Point at any
# SMTP server; a local Mailhog/Mailpit on 127.0.0.1:1025 works for dev.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com

# Mining webhook (jobs.RunMiningWebhook) — optional, off by default.
MINING_WEBHOOK_ENABLED=false
MINING_WEBHOOK_URL=
MINING_WEBHOOK_SECRET=

# CORS origin allowed to call this API with credentials — the Vue dev
# server's origin in local dev; your deployed frontend's origin in prod.
FRONTEND_ORIGIN=http://localhost:5173

# Runs the in-process recurring jobs (mining:update, mining:send-webhook,
# packages:weekly-sum, share:calculate) on this process. Leave true for a
# single-instance deployment; if you run more than one API process against
# the same database, set this to false on every instance but one so the
# jobs don't run twice.
ENABLE_SCHEDULER=true
