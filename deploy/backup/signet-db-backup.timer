# /etc/systemd/system/signet-db-backup.timer — see docs/S3_SETUP.md
[Unit]
Description=Daily Signet database backup to S3

[Timer]
# 02:00 Sri Lanka time (20:30 UTC). Change the zone/time as needed.
OnCalendar=*-*-* 02:00:00 Asia/Colombo
RandomizedDelaySec=5min
# Run at next boot if the server was off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
